# Copy this to /etc/nginx/sites-available/skillswap on your VM, then:
#   sudo ln -s /etc/nginx/sites-available/skillswap /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl restart nginx
#
# Replace yourdomain.com with your actual domain (e.g. from Duck DNS).
# Run certbot afterwards to add HTTPS: sudo certbot --nginx -d yourdomain.com

server {
    listen 80;
    server_name yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # Required for Socket.IO / WebSocket connections to work through Nginx
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
