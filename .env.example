SECRET_KEY=change-this-to-a-random-secret-string
DATABASE_URL=sqlite:///app.db

# Leave MAIL_SUPPRESS_SEND=True while testing locally - verification/reset
# links will print in your terminal instead of being emailed.
MAIL_SUPPRESS_SEND=True

# --- Brevo SMTP settings (recommended - free, no Gmail account-type limits) ---
# Sign up at brevo.com, then go to SMTP & API to get these values.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login-email@example.com
MAIL_PASSWORD=your-generated-brevo-smtp-key
# The "From" address shown to users - must be a sender you verified in Brevo
# (Settings > Senders & IP). Can be the same as MAIL_USERNAME.
MAIL_DEFAULT_SENDER=your-verified-sender@example.com

# --- OR: Gmail SMTP settings (only works with a normal, non-child account) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
